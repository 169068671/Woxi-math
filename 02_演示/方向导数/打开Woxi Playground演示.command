#!/bin/bash
# 打开已带方向导数代码的 Woxi Playground，点 Run 即可
URL="https://woxi.ad-si.com/playground/?---L3IAHcCYIAnaaAIgqLk6ZgTR0BATFkpeEjgPIhX3KZ5lod1WDJvBXgSXc+SAKbWgD+qd1kmeHqZJBVJW1DWOI1gGNSV3JNyDKHgLnoNEQA"
open "$URL"
osascript -e 'display dialog "网页已打开，代码会自动填进编辑框。\n\n等加载完成后点 Run（或 Shift+Enter），再拖 theta / h 滑块。" buttons {"好"} default button 1 with title "Woxi 在线 Playground"'
