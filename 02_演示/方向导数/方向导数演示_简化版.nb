Notebook[{
Cell["方向导数演示（简化版，同样给 Playground）", "Title"],
Cell["与「方向导数演示.wls」同一套代码。打开 https://woxi.ad-si.com/playground/ 粘贴下面 Input 后点 Run。不要用本机 Woxi Studio。", "Text"],
Cell["Manipulate[
 Module[{ux, uy, Ph, fPh, slope, exD, P, fP, arrowScale},
  P = {1, 1};
  fP = 1/2;
  arrowScale = 1.5;
  ux = Cos[theta];
  uy = Sin[theta];
  Ph = P + h {ux, uy};
  fPh = (Ph[[1]]^2 + Ph[[2]]^2)/4;
  slope = (fPh - fP)/h;
  exD = {1/2, 1/2} . {ux, uy};
  Show[
   Plot3D[(x^2 + y^2)/4, {x, -1, 3}, {y, -1, 3},
    PlotStyle -> Opacity[0.45], Mesh -> 6, PlotRange -> {0, 4}],
   Graphics3D[{
     Cyan, Arrow[{{1, 1, 0}, {1 + arrowScale ux, 1 + arrowScale uy, 0}}],
     RGBColor[0, 0.85, 0.3], Thick,
     Arrow[{Append[P, fP], Append[P, fP] + arrowScale {ux, uy, exD}}],
     Orange, Arrow[{Append[P, fP], Append[P, fP] + arrowScale {ux, uy, slope}}],
     Red, Sphere[Append[P, fP], 0.08],
     Orange, Sphere[Append[Ph, fPh], 0.06]
   }],
   ViewPoint -> {2.5, -2.5, 1.8}
  ]
 ],
 {{theta, Pi/4}, 0, 2 Pi, 0.05},
 {{h, 1.0}, 0.05, 2.0, 0.05}
]", "Input"]
}]
